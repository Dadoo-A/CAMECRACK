# CAMECRACK: minimal hostapd 2.8 build — OPEN AP only, nl80211, libnl-tiny, internal crypto.
# Goal: smallest static binary able to drive the ATBM6x6x (mac80211) chip via the
# nl80211 monitor-interface fallback (driver_params=use_monitor=1).
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL_TINY=y
CONFIG_LIBNL20=y
CONFIG_IEEE80211N=y

# No TLS library: internal primitives only (WPA code is always linked, even unused).
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y

# Strip everything an open captive-portal AP does not need.
CONFIG_NO_RADIUS=y
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_VLAN=y
CONFIG_NO_DUMP_STATE=y
CONFIG_NO_RANDOM_POOL=y
CONFIG_NO_GITVER=y
CONFIG_NO_RC4=y
CONFIG_ELOOP_POLL=y

# Keep the control socket (hostapd_cli / ctrl_interface=) and stdout debug (-dd) for
# field diagnosis; flip CONFIG_NO_STDOUT_DEBUG=y if a few more KB are ever needed.
CONFIG_CTRL_IFACE=y
