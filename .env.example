# Copy this file to .env and adjust the values.
# The real .env is NOT versioned (see .gitignore).

# Camera IP on your local network
CAMERA_IP=192.168.1.50

# Telnet port, only used as a PTZ fallback when the camera runs from the SD card
# (no-SD mode: PTZ goes through the camera web page, CAM_HTTP_PORT=80)
TELNET_PORT=24

# PTZ paths on the camera: "auto" picks by itself (ptzctl in RAM without SD,
# the SD card's one otherwise). Only change it for a different firmware.
PTZCTL=auto
PTZ_CONF=auto

# LAN IP of the PC running Docker, announced for WebRTC (low-latency video).
# Without it the video still works, but over MSE (1-2 s delay).
HOST_IP=192.168.1.10

# Password of the camera web page (same as WEB_PASSWORD in the SD card liberator.conf).
# Empty if you did not set one.
CAM_WEB_PASSWORD=
